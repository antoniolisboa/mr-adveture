static var _cache := {}


## Devolve a textura pelo nome. Personagem: "player_<m|f>_<idle|run1|run2|jump>_<poder|none>".
static func tex(id: String) -> Texture2D:
	if not _cache.has(id):
		_cache[id] = _build(id)
	return _cache[id]


static func _build(id: String) -> Texture2D:
	var pal: Dictionary = PALETTE.duplicate()
	pal.merge(ArtNE.PALETTE, true)
	var rows: Array
	if id.begins_with("player_"):
		var parts := id.split("_")
		var head: Array = HEAD_M if parts[1] == "m" else HEAD_F
		rows = head + TORSO + LEGS[parts[2]]
		pal.merge(CHARACTER_COLORS[parts[1]], true)
		var power_id := "_".join(parts.slice(3))
		if power_id != "none":
			pal.merge(Powers.POWERS[power_id]["colors"], true)
	elif id == "box_used":
		rows = SPRITES["box"]
		pal.merge({"y": Color("8a6a3f"), "o": Color("6b4f2c"), "q": Color("6b4f2c"),
				"w": Color("6b4f2c"), "P": Color("5a3a22")}, true)
	elif SPRITES.has(id):
		rows = SPRITES[id]
	else:
		rows = ArtNE.SPRITES[id]
	return _make(rows, pal)


static func _make(rows: Array, pal: Dictionary) -> ImageTexture:
	var w := 0
	for r in rows:
		w = maxi(w, r.length())
	var img := Image.create(w, rows.size(), false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			var ch := row[x]
			if pal.has(ch):
				img.set_pixel(x, y, pal[ch])
	return ImageTexture.create_from_image(img)
